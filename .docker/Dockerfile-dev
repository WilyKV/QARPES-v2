# Dockerfile DEV pour QARPES-v2
FROM node:22-alpine
WORKDIR /app

# Met à jour npm à la dernière version stable
RUN npm install -g npm@latest

# Copie d'abord les fichiers de config et dépendances pour optimiser le cache
COPY package.json ./
COPY tsconfig.json ./
COPY vite.config.ts ./
COPY postcss.config.js ./
COPY tailwind.config.ts ./
COPY .env ./
COPY prisma ./prisma

ENV NODE_ENV=development

# Installation des dépendances (dev incluses)
RUN npm install --dev

# Copie le code source (sera monté en volume en dev, mais nécessaire pour build image)
COPY server ./server
COPY client ./client
COPY shared ./shared

EXPOSE 8080 5173

RUN npx prisma generate
RUN npx prisma db seed

# Commande de dev : le conteneur reste actif, on lance npm run dev à la main
CMD ["tail", "-f", "/dev/null"]
