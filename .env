# Exemple de configuration pour QARPES-v2
# Backend/Frontend
NODE_ENV=development
PORT=8080
FORCE_FIXTURES=true

# Base de données (doit correspondre à la config docker-compose)
DB_HOST=db
DB_PORT=5432
DB_NAME=qarpes
DB_USER=qarpes
DB_PASSWORD=qarpes

DATABASE_URL=postgresql://qarpes:qarpes@db:5432/qarpes

# Session configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# (Ajoute ici d'autres variables nécessaires à ton app, ex: secrets, Azure, etc)
