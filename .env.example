# Exemple de configuration pour QARPES-v2
# Copier ce fichier en .env et remplir les valeurs réelles
# Backend/Frontend
NODE_ENV=development
PORT=8080
FORCE_FIXTURES=true

# Base de données (doit correspondre à la config docker-compose)
DB_HOST=db
DB_PORT=5432
DB_NAME=qarpes
DB_USER=qarpes
DB_PASSWORD=changeme

DATABASE_URL=postgresql://qarpes:changeme@db:5432/qarpes

# Session configuration
SESSION_SECRET=replace-with-crypto-randomBytes-64-hex

# Microsoft Azure AD (optionnel - demo mode disponible sans ces variables)
# MICROSOFT_CLIENT_ID=your-client-id
# MICROSOFT_TENANT_ID=your-tenant-id
# MICROSOFT_CLIENT_SECRET=your-client-secret
