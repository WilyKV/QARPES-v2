// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

// Prisma schema for QARPES-v2 (généré à partir du schéma Drizzle)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @db.VarChar(255)
  email          String?   @unique
  firstName      String?
  lastName       String?
  profileImageUrl String?
  role           String    @default("viewer")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())
  teamsLed       Team[]    @relation("LeaderOfTeams")
  requestedArbs  Arb[]     @relation("RequesterArbs")
  approvedArbs   Arb[]     @relation("ApproverArbs")
  auditLogs      AuditLog[]
  member         Member?   @relation("UserMember")
}

model Member {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String   @unique
  phone       String?
  position    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  userId      String?  @unique @db.VarChar(255)
  user        User?    @relation("UserMember", fields: [userId], references: [id])
  teamMembers TeamMember[]
}

model Team {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  leaderId    String?     @db.VarChar(255)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now())
  leader      User?       @relation("LeaderOfTeams", fields: [leaderId], references: [id])
  members     TeamMember[]
  projects    Project[]
  arbs        Arb[]
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int
  memberId  Int
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id])
  member    Member   @relation(fields: [memberId], references: [id])
  
  @@unique([teamId, memberId])
}

model Project {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?
  status        String     @default("development")
  teamId        Int?
  repositoryUrl String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now())
  team          Team?      @relation(fields: [teamId], references: [id])
  releaseProjects ReleaseProject[]
  arbs Arb[]
  projectVersions ProjectVersion[]
}

model Release {
  id              Int      @id @default(autoincrement())
  releaseId       String   @unique @db.VarChar(20)
  name            String
  description     String?
  status          String   @default("testing")
  recetteDate     DateTime?
  preprodDate     DateTime?
  productionDate  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  releaseProjects ReleaseProject[]
  projectVersions ProjectVersion[]
}

model ReleaseProject {
  id         Int      @id @default(autoincrement())
  releaseId  Int
  projectId  Int
  addedAt    DateTime @default(now())
  release    Release  @relation(fields: [releaseId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])
  
  @@unique([releaseId, projectId])
}

model Arb {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  type         String
  status       String   @default("pending")
  requesterId  String   @db.VarChar(255)
  approverId   String?  @db.VarChar(255)
  teamId       Int?
  projectId    Int?
  budget       Int?
  priority     String   @default("medium")
  dueDate      DateTime?
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  requester    User     @relation("RequesterArbs", fields: [requesterId], references: [id])
  approver     User?    @relation("ApproverArbs", fields: [approverId], references: [id])
  team         Team?    @relation(fields: [teamId], references: [id])
  project      Project? @relation(fields: [projectId], references: [id])
}

model ProjectVersion {
  id          Int       @id @default(autoincrement())
  projectId   Int
  version     String
  status      String    @default("development")
  description String?
  note        String?
  releaseId   Int?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  project     Project   @relation(fields: [projectId], references: [id])
  release     Release?  @relation(fields: [releaseId], references: [id])
  versionGitRepos ProjectVersionGitRepo[]
  cabs        Cab[]
  pvs         ProjectPv[]
}

model Commit {
  id                   Int      @id @default(autoincrement())
  versionGitRepoId     Int
  hash                 String
  message              String
  author               String
  authorEmail          String?
  committedAt          DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now())
  versionGitRepo       ProjectVersionGitRepo @relation(fields: [versionGitRepoId], references: [id])
}

model Cab {
  id               Int      @id @default(autoincrement())
  projectVersionId Int
  environment      String   // "preprod" ou "prod"
  helpdeskUrl      String
  status           String   @default("cree") // "cree", "demande", "valide", "refuse"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id])
}

model Procedure {
  id          Int      @id @default(autoincrement())
  versionGitRepoId Int
  type        String
  title       String
  description String?
  content     Json
  order       Int?
  isCompleted Boolean? @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  versionGitRepo ProjectVersionGitRepo @relation(fields: [versionGitRepoId], references: [id])
}

model ProjectPv {
  id               Int      @id @default(autoincrement())
  projectVersionId Int
  category         String   @default("pv_fonctionnel_recette")
  status           String   @default("en_cours") // "en_cours", "validation", "valide", "refuse"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id])
  files            PvFile[]
}

model PvFile {
  id       Int    @id @default(autoincrement())
  pvId     Int
  fileName String
  filePath String
  fileSize Int?
  mimeType String?
  uploadedAt DateTime @default(now())
  pv       ProjectPv @relation(fields: [pvId], references: [id])
}

model GitRepo {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(255)
  url              String?
  branch           String?  @db.VarChar(255)
  lastCommitHash   String?  @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  versionGitRepos  ProjectVersionGitRepo[]
}

// Table d'association many-to-many entre ProjectVersion et GitRepo
model ProjectVersionGitRepo {
  id               Int      @id @default(autoincrement())
  projectVersionId Int
  gitRepoId        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())
  projectVersion   ProjectVersion @relation(fields: [projectVersionId], references: [id])
  gitRepo          GitRepo @relation(fields: [gitRepoId], references: [id])
  procedures       Procedure[]
  commits          Commit[]
  
  @@unique([projectVersionId, gitRepoId])
}

model AuditLog {
  id         Int       @id @default(autoincrement())
  userId     String?   @db.VarChar(255)
  action     String    @db.VarChar(50)
  resource   String    @db.VarChar(50)
  resourceId String?   @db.VarChar(255)
  metadata   Json?
  ipAddress  String?   @db.VarChar(45)
  userAgent  String?   @db.VarChar(200)
  timestamp  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("sessions")
}
